# Native development reserves a free loopback/Tailscale port automatically.
# Optional: DEV_WEIGHTS_DIR=/absolute/host/path/to/weights
SITE_TITLE=LLM From Scratch Demos
# Directory (inside the container) holding one .pth per demo. Each demo is shown
# only if its weights file is present; see app/demos.py for the expected names
# (e.g. model.dickens.pth for JaneGPT, gpt2-small.pth for the GPT-2 demo).
# Production containers use WEIGHTS_DIR=/weights. For development use a host
# path via DEV_WEIGHTS_DIR, or let the launcher find local/shared checkpoints.
MODEL_DEVICE=cpu
WEB_CONCURRENCY=1

